# This repository is a client-pack distribution project, not an SPT/game backup.
# Default-deny everything at the SPT installation root.
/*

# Repository metadata and documentation.
!/.gitignore
!/.gitattributes
!/README.md
!/RELEASE-NOTES.md

# Reproducible client-pack builder. The live connection note is deliberately
# excluded because it contains a host address that should only be shared privately.
!/Multiplayer Setup/
/Multiplayer Setup/*
!/Multiplayer Setup/Pack Builder/
/Multiplayer Setup/Pack Builder/*
!/Multiplayer Setup/Pack Builder/BUILD-FRIEND-PACK.ps1
!/Multiplayer Setup/Pack Builder/FRIEND-GUIDE.html
!/Multiplayer Setup/Pack Builder/FRIEND-INSTALL.ps1
!/Multiplayer Setup/Pack Builder/FRIEND-QUICK-START-REMOTE.png
!/Multiplayer Setup/Pack Builder/FRIEND-QUICK-START.png
!/Multiplayer Setup/Pack Builder/FRIEND-README.txt
!/Multiplayer Setup/Pack Builder/INSTALL-FRIEND-PACK.cmd
!/Multiplayer Setup/Pack Builder/OPEN-GUIDE.cmd
!/Multiplayer Setup/Pack Builder/VERIFY-FRIEND-PACK.ps1

# Validated client release only. Expanded/generated copies and old releases stay local.
!/Multiplayer Setup/Friend Pack/
/Multiplayer Setup/Friend Pack/*
!/Multiplayer Setup/Friend Pack/SPT-Fika-CLIENT-Pack-4.1.6-native-ai-client.5.zip
!/Multiplayer Setup/Friend Pack/SPT-Fika-CLIENT-Pack-4.1.6-native-ai-client.5.zip.sha256.txt

